{
  "name": "@absolutejs/collectibles",
  "version": "0.1.2",
  "description": "Deterministic collectible sets, editions, shuffled serials, weighted traits, rarity explanations, and population reports for AbsoluteJS apps.",
  "type": "module",
  "license": "BSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/collectibles.git"
  },
  "homepage": "https://github.com/absolutejs/collectibles",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "changelog.json",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/manifest.ts --root ./src --outdir dist --sourcemap --target=bun && tsc --project tsconfig.build.json && absolute-manifest emit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:package": "bun run typecheck && bun run test && bun run build && absolute-changelog check",
    "prepublishOnly": "absolute-changelog check"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.9.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@absolutejs/changelog": "^0.4.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
